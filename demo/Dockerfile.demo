FROM python:3.12-slim

WORKDIR /app

# Copy package metadata and source — order matters for layer caching.
# If pyproject.toml changes, deps reinstall. If only src/ changes, they don't.
COPY pyproject.toml ./
COPY src/ ./src/

# Install aperture-nexus (core deps only — no CLIP, no video, no PyTorch).
# The demo uses commit() + metadata filter search, which requires nothing heavy.
RUN pip install --no-cache-dir -e .

COPY demo/quickstart_demo.py ./demo/quickstart_demo.py

CMD ["python", "demo/quickstart_demo.py"]
