# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.
#
#   cp .env.example .env

# ── ApertureDB connection ─────────────────────────────────────────────────────
#
# Option A: encoded key (recommended — generated by adb-nexus init or adb config)
# APERTUREDB_KEY=adbp_xxxx...
#
# Option B: JSON config — used when connecting to the local Docker instance.
# use_ssl must be false for the community edition container.
APERTUREDB_JSON={"host":"localhost","port":55556,"username":"admin","password":"admin","use_ssl":false}

# ── aperture-nexus ────────────────────────────────────────────────────────────
APERTURE_NEXUS_LOG_LEVEL=ERROR

# Required if ui.host is not 127.0.0.1
# APERTURE_NEXUS_UI_API_KEY=your-secret-key
