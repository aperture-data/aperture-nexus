# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.
#
#   cp .env.example .env

# ── ApertureDB connection ─────────────────────────────────────────────────────
#
# Option A: encoded key (recommended — generated by adb-nexus init or adb config)
# APERTUREDB_KEY=adbp_xxxx...
#
# Option B: individual fields (used when connecting to community edition locally)
APERTUREDB_HOST=localhost
APERTUREDB_PORT=55555
APERTUREDB_USER=admin
APERTUREDB_PASSWORD=admin

# ── Docker Compose port override ──────────────────────────────────────────────
#
# Mac users: if port 55555 conflicts, set a different host port here.
# The container still listens on 55555 internally.
# APERTUREDB_PORT=15555

# ── aperture-nexus ────────────────────────────────────────────────────────────
APERTURE_NEXUS_LOG_LEVEL=ERROR

# Required if ui.host is not 127.0.0.1
# APERTURE_NEXUS_UI_API_KEY=your-secret-key
